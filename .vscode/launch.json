    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "name": "start",
            "request": "launch",
            "command": "npx expo start",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node-terminal",
            "name": "swagger",
            "request": "launch",
            "command": "npm run swagger-axios",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node-terminal",
            "name": "ios",
            "request": "launch",
            "command": "expo run:ios",
            "cwd": "${workspaceFolder}"
        },
    ]
}
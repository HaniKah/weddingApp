{
  "name": "weddingapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "swagger-axios": "swagger-typescript-api generate -p http://localhost:3000/swagger/json -o ./types -n open-api.ts --http-client axios",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:ci": "jest --ci --runInBand",
    "update:preview": "eas update --branch preview --environment preview",
    "update:production": "eas update --branch production --environment production",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ]
  },
  "dependencies": {
    "@expo/ui": "~57.0.9",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "axios": "^1.11.0",
    "compare-versions": "^6.1.1",
    "expo": "~57.0.28",
    "expo-auth-session": "~57.0.15",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.4",
    "image-size": "^2.0.4",
    "libphonenumber-js": "^1.13.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-maps": "~1.27.2",
    "react-native-progress": "^5.0.1",
    "react-native-purchases": "^8.12.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "~29.5.14",

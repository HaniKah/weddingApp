    "baseline-browser-mapping": "^2.9.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.2.3",
    "swagger-typescript-api": "^13.13.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "braces": "^3.0.3",
    "decode-uri-component": "^0.4.1",
    "fast-xml-parser": "^5.7.0",
    "image-size": "^2.0.4",
    "node-forge": "^1.3.1",
    "sprintf-js": "^1.1.3",
    "uuid": "^11.1.1"
  }
